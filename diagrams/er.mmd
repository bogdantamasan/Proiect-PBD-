Project SportClub {
  database_type: 'PostgreSQL'
  Note: 'Baza de date pentru Gestiunea Clubului Sportiv'
}

Table Sectii [headercolor: #1976D2] {
  ID_Sectie int [pk, increment]
  Nume_Sectie varchar [not null]
  Descriere text
}

Table Antrenori [headercolor: #388E3C] {
  ID_Antrenor int [pk, increment]
  Nume varchar [not null]
  Prenume varchar [not null]
  Specializare varchar
  Telefon varchar
  Email varchar [unique]
  Salariu decimal [note: 'CHECK > 0']
}

Table Membri [headercolor: #E64A19] {
  ID_Membru int [pk, increment]
  Nume varchar [not null]
  Prenume varchar [not null]
  Data_Nasterii date
  Telefon varchar
  Email varchar [unique]
  Data_Inscrierii date
}

Table Abonamente [headercolor: #FBC02D] {
  ID_Abonament int [pk, increment]
  Tip_Abonament varchar [not null]
  Pret decimal
  Numar_Sedinte int
  Valabilitate_Luni int
}

Table Achizitii [headercolor: #7B1FA2] {
  ID_Achizitie int [pk, increment]
  ID_Membru int [ref: > Membri.ID_Membru]
  ID_Abonament int [ref: > Abonamente.ID_Abonament]
  Data_Inceput date
  Data_Sfarsit date
  Sedinte_Ramas int
}

Table Programari [headercolor: #0097A7] {
  ID_Programare int [pk, increment]
  ID_Sectie int [ref: > Sectii.ID_Sectie]
  ID_Antrenor int [ref: > Antrenori.ID_Antrenor]
  Data_Ora datetime
  Locatie varchar
}

Table Prezente [headercolor: #5D4037] {
  ID_Prezenta int [pk, increment]
  ID_Programare int [ref: > Programari.ID_Programare]
  ID_Membru int [ref: > Membri.ID_Membru]
  Status varchar [note: 'Prezent/Absent']
}

Table CHURN_PREDICTIONS [headercolor: #D32F2F] {
  ID_Predictie int [pk, increment]
  ID_Membru int [ref: > Membri.ID_Membru]
  Scor_Risc float
  Categorie_Risc varchar
  Data_Evaluare date
}
